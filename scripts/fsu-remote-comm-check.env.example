# ============================================================================
# FSU 远程通信检查 — 环境配置模板
# ============================================================================
# 复制为 env.remote 并按现场实际情况修改:
#   cp env.example env.remote
#   nano env.remote
#
# 使用:
#   set -a && source ./env.remote && set +a
#   ./fsu-remote-comm-check.sh
#
# 安全提醒:
#   - env.remote 不应提交到 git
#   - 不要在此文件中写真实 token/密码
# ============================================================================

# ---- 平台服务 ----
PLATFORM_HOST=127.0.0.1
PLATFORM_PORT=8080
PLATFORM_SC_PATH=/services/SCService

# ---- FSU 现场设备 ----
FSU_HOST=
FSU_PORT=80
FSU_SERVICE_PATH=/services/FSUService

# ---- 站点信息 ----
STATION_NAME=1
FSUID=

# ---- 认证 ----
AUTH_TOKEN=

# ---- 功能开关 ----
ENABLE_PROTOCOL_PROBE=false
ENABLE_LOCAL_SC_MOCK=false
ENABLE_TCPDUMP=false
TCPDUMP_INTERFACE=any

# ---- 路径 ----
LOG_DIR=/opt/fsu-tools/remote-comm-check/logs
TIMEOUT_SECONDS=5

# ============================================================================
# FSU 独立通信检查 — 环境配置 (无平台依赖)
# ============================================================================
# cp env.example env.remote && nano env.remote
# FSU_HOST=192.168.x.x ./fsu-standalone-comm-check.sh
# ============================================================================

FSU_HOST=
FSU_PORT=80
FSU_SERVICE_PATH=/services/FSUService
FSU_SCHEME=http

STATION_NAME=1
FSUID=

ENABLE_SOAP_PROBE=false
SOAP_PROBE_COMMAND=GET_FSUINFO
ENABLE_TCPDUMP=false
TCPDUMP_INTERFACE=any

LOG_DIR=/opt/fsu-tools/standalone-fsu-check/logs
TIMEOUT_SECONDS=5
